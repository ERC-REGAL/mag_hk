    (fun s _ => upper_identity s) (fun s _ => by rw [upper_square]; positivity)
  rw [← normIntegral_eq_literal _ (by norm_num)] at h
  exact h.2.trans_lt upper_moment

/-- The unique positive parameter rounds to 1.639 at three decimals. -/
theorem parameter_interval (t : ℝ) (ht : 0 < t) (heq : normIntegral t = 1 / 2) :
    (3277 / 2000 : ℝ) < t ∧ t < (3279 / 2000 : ℝ) := by
  constructor
  · by_contra h
    have hm := normIntegral_strictAnti.antitoneOn ht.le (by norm_num :
      (3277 / 2000 : ℝ) ∈ Ici 0) (le_of_not_gt h)
    rw [heq] at hm
    exact (not_lt_of_ge hm) integral_lower
  · by_contra h
    have hm := normIntegral_strictAnti.antitoneOn
      (by norm_num : (3279 / 2000 : ℝ) ∈ Ici 0) ht.le (le_of_not_gt h)
    rw [heq] at hm
    exact (not_lt_of_ge hm) integral_upper

theorem literal_parameter_interval (t : ℝ) (ht : 0 < t)
    (heq : (∫ s : ℝ in Ioi 0, Real.exp (-s) / (1 + t * s)) = 1 / 2) :
    (3277 / 2000 : ℝ) < t ∧ t < (3279 / 2000 : ℝ) :=
  parameter_interval t ht ((normIntegral_eq_literal t ht.le).trans heq)

theorem exists_parameter_in_interval : ∃ t : ℝ, 0 < t ∧
    normIntegral t = 1 / 2 ∧ (3277 / 2000 : ℝ) < t ∧ t < (3279 / 2000 : ℝ) := by
  obtain ⟨t, ht, heq⟩ := exists_parameter
  have heq' := (normIntegral_eq_literal t ht.le).trans heq
  exact ⟨t, ht, heq', parameter_interval t ht heq'⟩

end MagHK.GaussianParameterBounds
